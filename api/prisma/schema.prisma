generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

model Word {
  id         Int           @id @default(autoincrement())
  english    String        @unique @db.VarChar(60)
  hint       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  phonemes   WordPhoneme[]
  activities ActivityWord[]
}

model Phoneme {
  id     Int           @id @default(autoincrement())
  symbol String        @unique @db.VarChar(20)
  words  WordPhoneme[]
}

model WordPhoneme {
  wordId    Int
  phonemeId Int
  position  Int
  word      Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  phoneme   Phoneme @relation(fields: [phonemeId], references: [id], onDelete: Restrict)

  @@id([wordId, position])
  @@index([phonemeId])
}

model Activity {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  type        ActivityType
  difficulty  String        @default("standard") @db.VarChar(30)
  maxGuesses  Int           @default(6)
  showHints   Boolean       @default(true)
  gridSize    Int           @default(8)
  outputTitle String        @db.VarChar(120)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  words       ActivityWord[]
}

model ActivityWord {
  activityId Int
  wordId     Int
  position   Int      @default(0)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([activityId, wordId])
  @@index([wordId])
}
